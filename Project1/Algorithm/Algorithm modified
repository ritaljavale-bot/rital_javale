flowchart TD
    A([Start]) --> B["Define Node: Token No, Next pointer"]
    B --> C["Initialize front = NULL, rear = NULL, top = NULL"]
    C --> D{"Select Operation"}

    D -->|Queue| Q{"Queue Operation"}
    D -->|Stack| S{"Stack Operation"}
    D -->|Exit| Z([Stop])

    Q -->|Insert| Q1["Create new node"]
    Q1 --> Q2["Insert at rear, update rear"]
    Q2 --> D

    Q -->|Delete| Q3{"Queue empty?"}
    Q3 -->|Yes| Q4["Display Underflow"]
    Q3 -->|No| Q5["Remove front node, update front"]
    Q4 --> D
    Q5 --> D

    Q -->|Search| Q6["Traverse queue from front"]
    Q6 --> Q7{"Token found?"}
    Q7 -->|Yes| Q8["Display token found"]
    Q7 -->|No| Q9["Display not found"]
    Q8 --> D
    Q9 --> D

    Q -->|Display| Q10["Display all pending tokens"]
    Q10 --> D

    S -->|PUSH| S1["Create new node"]
    S1 --> S2["Insert at top, update top"]
    S2 --> D

    S -->|POP| S3{"Stack empty?"}
    S3 -->|Yes| S4["Display Underflow"]
    S3 -->|No| S5["Remove top node, update top"]
    S4 --> D
    S5 --> D

    S -->|PEEK| S6{"Stack empty?"}
    S6 -->|Yes| S7["Display Stack empty"]
    S6 -->|No| S8["Display top element"]
    S7 --> D
    S8 --> D

    S -->|Display| S9["Display all stack elements"]
    S9 --> D
